{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/sd-ota-manifest-v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "layout_revision",
    "published_at",
    "archive",
    "catalog",
    "mobile",
    "region"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "product": {"const": "WatcheRobot-S3"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "layout_revision": {"const": 3},
    "published_at": {"type": "string", "format": "date-time"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "size", "expanded_size", "file_count", "object_count", "sha256", "url"],
      "properties": {
        "name": {"type": "string", "pattern": "^watche-sd-resources-v[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.gz$"},
        "format": {"const": "tar.gz"},
        "size": {"type": "integer", "minimum": 1},
        "expanded_size": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "object_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "url": {"type": "string", "format": "uri"},
        "github_url": {"type": "string", "format": "uri"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "url"],
      "properties": {
        "name": {"const": "catalog.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "url": {"type": "string", "format": "uri"},
        "github_url": {"type": "string", "format": "uri"}
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "assets"],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "size", "sha256", "url"],
          "properties": {
            "name": {"const": "mobile_catalog.json"},
            "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "url": {"type": "string", "format": "uri"},
            "github_url": {"type": "string", "format": "uri"}
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "count", "size", "base_url"],
          "properties": {
            "format": {"const": "individual-gif"},
            "count": {"type": "integer", "minimum": 1, "maximum": 128},
            "size": {"type": "integer", "minimum": 1},
            "base_url": {"type": "string", "format": "uri"},
            "github_base_url": {"type": "string", "format": "uri"}
          }
        }
      }
    },
    "region": {"enum": ["cn", "global"]}
  },
  "if": {"properties": {"region": {"const": "global"}}},
  "then": {
    "properties": {
      "archive": {"required": ["github_url"]},
      "catalog": {"required": ["github_url"]},
      "mobile": {"properties": {"catalog": {"required": ["github_url"]}, "assets": {"required": ["github_base_url"]}}}
    }
  },
  "else": {
    "properties": {
      "archive": {"not": {"required": ["github_url"]}},
      "catalog": {"not": {"required": ["github_url"]}},
      "mobile": {
        "properties": {
          "catalog": {"not": {"required": ["github_url"]}},
          "assets": {"not": {"required": ["github_base_url"]}}
        }
      }
    }
  }
}
