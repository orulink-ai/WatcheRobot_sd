{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/source-snapshot-v1.json",
  "title": "WatcheRobot Feishu source snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "imported_at", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"const": "Watcher expression overview"},
    "imported_at": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_record_id", "source_label", "display_name", "resource_id", "order", "loop", "gif"],
        "properties": {
          "source_record_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_label": {"type": "string", "minLength": 1, "maxLength": 128},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
          "resource_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"},
          "order": {"type": "integer", "minimum": 0},
          "loop": {"type": "boolean"},
          "gif": {"type": "string", "minLength": 1},
          "action": {"type": ["string", "null"]},
          "sound": {"type": ["string", "null"]}
        }
      }
    }
  }
}

