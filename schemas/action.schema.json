{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/device-action-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene_name", "frame_start", "frame_end", "fps", "animated_objects"],
  "properties": {
    "scene_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "frame_start": {"type": "integer", "minimum": 0},
    "frame_end": {"type": "integer", "minimum": 0},
    "fps": {"type": "integer", "minimum": 1, "maximum": 1000},
    "animated_objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_name", "object_type", "action_name", "keyframe_data"],
        "properties": {
          "object_name": {"enum": ["body_x", "head_y"]},
          "object_type": {"enum": ["MESH", "EMPTY"]},
          "action_name": {"type": "string", "minLength": 1, "maxLength": 128},
          "keyframe_data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frame_number", "active_axis", "rotation_angle"],
              "properties": {
                "frame_number": {"type": "integer", "minimum": 0},
                "active_axis": {"enum": ["z", "x"]},
                "rotation_angle": {"type": "integer", "minimum": 0, "maximum": 180}
              }
            }
          }
        }
      }
    }
  }
}

