{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/resource-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "bundle_id", "bundle_version", "generated_at", "compatibility", "contents", "files", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "WatcheRobot-S3"},
    "bundle_id": {"const": "adepto-official"},
    "bundle_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "compatibility": {"type": "object"},
    "contents": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(anim|actions|sfx|behavior)/|^resource_catalog\\.json$"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

