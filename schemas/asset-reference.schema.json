{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/asset-reference-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "sha256", "size", "format"],
  "properties": {
    "kind": {"enum": ["anim", "action", "sfx"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "format": {
      "enum": ["animpack-v2", "firmware-action-json-v1", "pcm-s16le-24khz-mono"]
    }
  }
}
