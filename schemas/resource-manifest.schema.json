{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/resource-manifest-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "bundle_id",
    "bundle_version",
    "layout_revision",
    "generated_at",
    "compatibility",
    "contents",
    "files",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "product": {"const": "WatcheRobot-S3"},
    "bundle_id": {"const": "adepto-official"},
    "bundle_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "layout_revision": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "compatibility": {"type": "object"},
    "contents": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(assets/(anim/[a-f0-9]{64}\\.animpack|actions/[a-f0-9]{64}\\.json|sfx/[a-f0-9]{64}\\.pcm)|official_catalog\\.json|fixed_states\\.json)$"
          },
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
