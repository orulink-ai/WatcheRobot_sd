{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/official-catalog-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "expressions"],
  "properties": {
    "schema_version": {"const": 2},
    "format": {"const": "watche-official-catalog"},
    "expressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "source_record_id",
          "order",
          "assets"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
          "source_record_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "loop": {"type": "boolean", "deprecated": true},
          "order": {"type": "integer", "minimum": 0},
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["animation"],
            "properties": {
              "animation": {"$ref": "https://orulink.ai/schemas/watcher/asset-reference-v1.json"},
              "action": {"$ref": "https://orulink.ai/schemas/watcher/asset-reference-v1.json"},
              "sound": {"$ref": "https://orulink.ai/schemas/watcher/asset-reference-v1.json"}
            }
          }
        }
      }
    }
  }
}
