{
  "schema_version": 1,
  "product": "WatcheRobot-S3",
  "display": {
    "width": 206,
    "height": 206,
    "pixel_format": "rgb565",
    "byte_order": "big-endian",
    "default_fps": 10
  },
  "resource_id": {
    "pattern": "^[a-z][a-z0-9_]{0,22}$",
    "max_bytes": 23
  },
  "limits": {
    "expressions": 128,
    "frames_per_expression": 255,
    "action_files": 128,
    "sound_files": 128,
    "single_file_bytes": 16777216,
    "bundle_files": 512,
    "bundle_bytes": 100663296,
    "transfer_archive_bytes": 67108864
  },
  "audio": {
    "format": "pcm_s16le",
    "sample_rate_hz": 24000,
    "channels": 1,
    "sample_width_bits": 16
  },
  "fixed_states": [
    "boot",
    "standby",
    "listening",
    "thinking",
    "speaking",
    "processing",
    "error",
    "upgrade"
  ],
  "force_rgb565": ["bluetooth"]
}
