{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/mobile-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "version", "content_hash", "expressions"],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "watche-mobile-expression-catalog"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expressions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "order", "preview", "preview_sha256", "preview_size", "device"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
          "order": {"type": "integer", "minimum": 0},
          "preview": {"type": "string", "pattern": "^gif/[a-z][a-z0-9_]{0,22}\\.gif$"},
          "preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "preview_size": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "device": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_name"],
            "properties": {
              "image_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"},
              "action_file": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"},
              "sound_file": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,22}$"}
            }
          }
        }
      }
    }
  }
}
