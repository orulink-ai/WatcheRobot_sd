{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orulink.ai/schemas/watcher/asset-reference-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "path", "sha256", "size", "format"],
  "properties": {
    "kind": {"enum": ["anim", "action", "sfx"]},
    "path": {
      "type": "string",
      "pattern": "^(anim/[a-z][a-z0-9_]{0,22}\\.animpack|actions/[a-z][a-z0-9_]{0,22}\\.json|sfx/[a-z][a-z0-9_]{0,22}\\.pcm)$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size": {"type": "integer", "minimum": 1},
    "format": {
      "enum": ["animpack-v3", "firmware-action-json-v1", "pcm-s16le-24khz-mono"]
    }
  }
}
